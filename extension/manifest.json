{
  "manifest_version": 3,
  "name": "FileForge Personal MCP Bridge",
  "version": "0.3.0",
  "description": "Local MCP bridge giving Claude and other agents real browser context via Chrome APIs and CDP.",
  "key": "",

  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "bookmarks",
    "history",
    "debugger",
    "sidePanel"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background/mcpRpcRouter.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/mcpContentBridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_title": "FileForge"
  },

  "side_panel": {
    "default_path": "popup/popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
